{
  "name": "weather-shopper-playwright-assignment",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright and TypeScript UI automation assignment for Weather Shopper.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:payment": "playwright test --grep @payment",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "test:install-browsers": "playwright install chromium",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix",
    "check": "npm run lint && npm run typecheck",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.0",
    "eslint-plugin-playwright": "^2.11.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
